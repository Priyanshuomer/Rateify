# ── Core ──
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Where the React app lives. Used for redirects after email verification / Google login and reset links.
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=1
APP_NAME=StoreRate

# ── Database ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/store_rating?schema=public"

# ── Redis (pending signups) ──
REDIS_URL="redis://127.0.0.1:6379"

# ── JWT ── (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="<min-32-random-chars>"
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── Google OAuth ── (callbacks: BASE_URL/api/auth/google/login/callback and /google/signup/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── CORS ── comma separated; "regex:" prefix supported. Empty in dev = reflect any origin
CORS_ORIGINS="http://localhost:5173"

# ── Rate limiting ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# ── Email (nodemailer / gmail app password) ──
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM=""

# ── Cloudflare R2 ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ── Seed admin ──
ADMIN_NAME="System Administrator Account"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@12345"